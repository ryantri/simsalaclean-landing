# Google Apps Script Configuration
# Untuk diisi setelah Apps Script dibuat dan di-deploy

# URL Web App Apps Script (dapatkan dari deployment)
# Format: https://script.google.com/macros/d/[SCRIPT_ID]/usercopy/exec
REACT_APP_GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/d/YOUR_SCRIPT_ID/usercopy/exec

# Spreadsheet ID (dapatkan dari URL Google Sheets)
# Catatan: Ini bukan untuk frontend, hanya referensi untuk setup
# SPREADSHEET_ID disimpan di Script Properties di Google Apps Script
# SPREADSHEET_ID=your_spreadsheet_id_here
